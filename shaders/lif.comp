#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { float x[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint mode; uint n; uint width; uint unused; } p;
void main(){
    uint i=gl_GlobalInvocationID.x,n=p.n;if(i>=n)return;
    if(p.mode==0){float value=x[n*p.width+p.width+i];for(uint j=0;j<p.width;++j)value+=x[i*p.width+j]*x[n*p.width+j];y[i]=value;return;}
    uint col=i/64,id=i%64;bool exc=x[6*n+n*64+id]>0;
    float recurrent=0;for(uint j=0;j<64;++j)recurrent+=x[6*n+col*4096+id*64+j]*x[n+col*64+j];
    float neighbor=0;if(exc){if(col>0)neighbor+=x[n+i-64];if(i+64<n)neighbor+=x[n+i+64];}
    float decay=exc?.6:.4;
    float voltage=decay*x[i]+(1-decay)*(x[5*n+i]+recurrent+.08*neighbor);
    float spike=(voltage-(exc?1.:.6)-x[2*n+i]>=0?1.:0.)*(1-x[3*n+i]);
    y[i]=voltage*(1-spike);y[n+i]=.8*x[n+i]+.2*spike;
    y[2*n+i]=.98*x[2*n+i]+(exc?.03:0.)*spike;y[3*n+i]=spike;y[4*n+i]=x[4*n+i]+spike;
}
